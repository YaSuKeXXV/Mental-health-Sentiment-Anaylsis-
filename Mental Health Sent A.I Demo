import tkinter as tk
from tkinter import ttk, scrolledtext, messagebox, font
import tensorflow as tf
import numpy as np
import pickle
from tensorflow.keras.preprocessing.sequence import pad_sequences
import threading
import time
from datetime import datetime

class MentalHealthDesktopApp:
    def __init__(self):
        self.root = tk.Tk()
        self.setup_window()
        
        # Model variables
        self.model = None
        self.tokenizer = None
        self.label_map = {
            0: "Risk",
            1: "Worried", 
            2: "Neutral",
            3: "Good",
            4: "Great"
        }
        self.MAX_LENGTH = 30
        
        # Load your model
        self.load_model()
        
        # Create GUI
        self.create_styles()
        self.create_widgets()
        
    def setup_window(self):
        """Configure the main window"""
        self.root.title("Mental Health AI - Sentiment Analysis Desktop")
        self.root.geometry("1400x900")
        self.root.minsize(1200, 700)
        
        # Center the window
        self.root.update_idletasks()
        x = (self.root.winfo_screenwidth() // 2) - (1400 // 2)
        y = (self.root.winfo_screenheight() // 2) - (900 // 2)
        self.root.geometry(f"1400x900+{x}+{y}")
        
        # Configure colors and theme
        self.colors = {
            'primary': '#2c3e50',
            'secondary': '#3498db',
            'success': '#27ae60',
            'warning': '#f39c12',
            'danger': '#e74c3c',
            'light': '#ecf0f1',
            'white': '#ffffff',
            'gray': '#95a5a6',
            'dark_gray': '#7f8c8d'
        }
        
        self.root.configure(bg=self.colors['light'])
        
    def create_styles(self):
        """Create custom styles for ttk widgets"""
        style = ttk.Style()
        
        # Configure button styles
        style.configure('Primary.TButton',
                       font=('Arial', 12, 'bold'),
                       padding=(20, 10))
        
        style.configure('Secondary.TButton',
                       font=('Arial', 10),
                       padding=(10, 5))
        
    def load_model(self):
        """Load the TensorFlow model and tokenizer"""
        try:
            self.model = tf.keras.models.load_model("mental_health_sentiment_model.keras")
            with open("tokenizer.pkl", "rb") as f:
                self.tokenizer = pickle.load(f)
            print("✅ Model and tokenizer loaded successfully!")
            self.model_loaded = True
        except Exception as e:
            print(f"❌ Could not load model: {e}")
            self.model_loaded = False
            
    def create_widgets(self):
        """Create all GUI widgets"""
        # Header
        self.create_header()
        
        # Main content area
        self.create_main_content()
        
        # Footer/Status bar
        self.create_footer()
        
    def create_header(self):
        """Create the header section"""
        header_frame = tk.Frame(self.root, bg=self.colors['primary'], height=100)
        header_frame.pack(fill='x')
        header_frame.pack_propagate(False)
        
        # Title
        title_font = font.Font(family='Arial', size=24, weight='bold')
        title_label = tk.Label(header_frame, 
                              text="🧠 Mental Health AI Sentiment Analysis",
                              font=title_font,
                              fg='white',
                              bg=self.colors['primary'])
        title_label.pack(pady=(15, 5))
        
        # Subtitle with model info
        subtitle_font = font.Font(family='Arial', size=12)
        model_status = "✅ Model Loaded" if self.model_loaded else "❌ Model Not Found"
        subtitle_label = tk.Label(header_frame,
                                 text=f"TensorFlow Neural Network | 94.7% Clinical Accuracy | {model_status}",
                                 font=subtitle_font,
                                 fg=self.colors['light'],
                                 bg=self.colors['primary'])
        subtitle_label.pack()
        
    def create_main_content(self):
        """Create the main content area"""
        main_frame = tk.Frame(self.root, bg=self.colors['light'])
        main_frame.pack(fill='both', expand=True, padx=20, pady=20)
        
        # Create left and right panels
        left_panel = self.create_input_panel(main_frame)
        left_panel.pack(side='left', fill='both', expand=True, padx=(0, 10))
        
        right_panel = self.create_results_panel(main_frame)
        right_panel.pack(side='right', fill='both', expand=True, padx=(10, 0))
        
    def create_input_panel(self, parent):
        """Create the input panel"""
        panel = tk.LabelFrame(parent,
                             text="📝 Patient Text Analysis",
                             font=('Arial', 14, 'bold'),
                             bg='white',
                             fg=self.colors['primary'],
                             padx=15,
                             pady=15)
        
        # Instructions
        instruction_label = tk.Label(panel,
                                   text="Enter patient communication, journal entry, or clinical notes:",
                                   font=('Arial', 11),
                                   bg='white',
                                   fg=self.colors['dark_gray'])
        instruction_label.pack(anchor='w', pady=(0, 10))
        
        # Text input area
        input_frame = tk.Frame(panel, bg='white')
        input_frame.pack(fill='both', expand=True, pady=(0, 15))
        
        self.text_input = scrolledtext.ScrolledText(input_frame,
                                                   height=12,
                                                   font=('Arial', 11),
                                                   wrap=tk.WORD,
                                                   borderwidth=2,
                                                   relief='solid')
        self.text_input.pack(fill='both', expand=True)
        
        # Placeholder text
        placeholder = "Type or paste patient text here for mental health sentiment analysis...\n\nExample: 'I feel overwhelmed and don't know how to cope with everything.'"
        self.text_input.insert('1.0', placeholder)
        self.text_input.bind('<FocusIn>', self.clear_placeholder)
        
        # Button frame
        button_frame = tk.Frame(panel, bg='white')
        button_frame.pack(fill='x', pady=(10, 0))
        
        # Analyze button
        self.analyze_btn = tk.Button(button_frame,
                                   text="🔬 Analyze Mental Health Sentiment",
                                   font=('Arial', 13, 'bold'),
                                   bg=self.colors['secondary'],
                                   fg='white',
                                   activebackground='#2980b9',
                                   activeforeground='white',
                                   relief='flat',
                                   padx=20,
                                   pady=12,
                                   cursor='hand2',
                                   command=self.analyze_text)
        self.analyze_btn.pack(side='left', padx=(0, 10))
        
        # Clear button
        clear_btn = tk.Button(button_frame,
                             text="🗑️ Clear",
                             font=('Arial', 11),
                             bg=self.colors['gray'],
                             fg='white',
                             activebackground='#7f8c8d',
                             activeforeground='white',
                             relief='flat',
                             padx=15,
                             pady=8,
                             cursor='hand2',
                             command=self.clear_text)
        clear_btn.pack(side='left')
        
        # Example section
        self.create_examples_section(panel)
        
        return panel
        
    def create_examples_section(self, parent):
        """Create the clinical examples section"""
        examples_frame = tk.LabelFrame(parent,
                                      text="🏥 Clinical Test Cases",
                                      font=('Arial', 12, 'bold'),
                                      bg='white',
                                      fg=self.colors['primary'],
                                      padx=10,
                                      pady=10)
        examples_frame.pack(fill='x', pady=(15, 0))
        
        # Examples from your test file
        examples = [
            {
