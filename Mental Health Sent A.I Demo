    def analyze_text(self):
        """Analyze the input text"""
        text = self.text_input.get('1.0', tk.END).strip()
        
        if not text or "Type or paste patient text here" in text:
            messagebox.showwarning("⚠️ Input Required", 
                                 "Please enter some patient text to analyze.")
            return
            
        if not self.model_loaded:
            messagebox.showerror("❌ Model Error", 
                               "AI model is not loaded. Please ensure model files are present.")
            return
            
        # Disable button and show processing
        self.analyze_btn.configure(state='disabled', 
                                  text="🔄 Analyzing...",
                                  bg=self.colors['gray'])
        self.status_var.set("🔄 Processing through neural network...")
        self.root.update()
        
        # Run analysis in separate thread
        thread = threading.Thread(target=self.perform_analysis, args=(text,))
        thread.daemon = True
        thread.start()
        
    def perform_analysis(self, text):
        """Perform the actual ML analysis"""
        start_time = time.time()
        
        try:
            # Preprocess text using your model's approach
            sequence = self.tokenizer.texts_to_sequences([text])
            padded = pad_sequences(sequence, maxlen=self.MAX_LENGTH, padding='post')
            
            # Get prediction
            prediction = self.model.predict(padded, verbose=0)
            
            # Extract results
            class_index = np.argmax(prediction)
            confidence = float(np.max(prediction))
            predicted_class = self.label_map[class_index]
            
            # Create probability breakdown
            breakdown = {}
            for i, prob in enumerate(prediction[0]):
                breakdown[self.label_map[i]] = round(float(prob) * 100, 1)
                
            processing_time = time.time() - start_time
            
            # Update GUI in main thread
            self.root.after(0, self.display_results, text, predicted_class, 
                          confidence, breakdown, processing_time)
            
        except Exception as e:
            self.root.after(0, lambda: self.show_error(f"Analysis failed: {str(e)}"))
        finally:
            self.root.after(0, self.reset_analyze_button)
            
    def display_results(self, input_text, predicted_class, confidence, breakdown, processing_time):
        """Display analysis results"""
        # Color and icon mapping
        class_colors = {
            'Risk': ('🚨', '#e74c3c'),
            'Worried': ('😰', '#f39c12'), 
            'Neutral': ('😐', '#95a5a6'),
            'Good': ('😊', '#27ae60'),
            'Great': ('🌟', '#2ecc71')
        }
        
        icon, color = class_colors.get(predicted_class, ('🧠', '#3498db'))
        
        # Create detailed results text
        results_text = f"""
🎯 MENTAL HEALTH SENTIMENT ANALYSIS RESULTS
═══════════════════════════════════════════════════════════════

📝 INPUT TEXT:
"{input_text[:200]}{'...' if len(input_text) > 200 else ''}"

{icon} CLASSIFICATION: {predicted_class.upper()}
📊 Model Confidence: {confidence*100:.1f}%
⏱️ Processing Time: {processing_time:.3f} seconds

📈 PROBABILITY BREAKDOWN:
"""
        
        # Add sorted probability breakdown
        for class_name, percentage in sorted(breakdown.items(), key=lambda x: x[1], reverse=True):
            class_icon = class_colors.get(class_name, ('🧠', '#000000'))[0]
            bar = '█' * int(percentage // 5) + '░' * (20 - int(percentage // 5))
            results_text += f"  {class_icon} {class_name:8}: {percentage:5.1f}% [{bar}]\n"
            
        # Add clinical recommendations
        recommendations = {
            'Risk': {
                'title': '🚨 IMMEDIATE SUPPORT RECOMMENDED',
                'message': 'CRITICAL: Potential mental health crisis detected.',
                'action': 'Consider connecting with a mental health professional or crisis helpline IMMEDIATELY.',
                'priority': 'HIGH PRIORITY'
            },
            'Worried': {
                'title': '😰 MONITORING SUGGESTED',
                'message': 'Signs of anxiety, stress, or emotional distress detected.',
                'action': 'Schedule consultation with counselor or therapist. Regular check-ins recommended.',
                'priority': 'MODERATE PRIORITY'
            },
            'Neutral': {
                'title': '😐 STABLE MENTAL STATE',
                'message': 'Indicates balanced emotional state with no immediate concerns.',
                'action': 'Continue regular wellness practices and routine mental health check-ins.',
                'priority': 'ROUTINE MONITORING'
            },
            'Good': {
                'title': '😊 POSITIVE MENTAL HEALTH',
                'message': 'Shows good emotional wellbeing and positive coping mechanisms.',
                'action': 'Maintain current practices. Consider peer support opportunities.',
                'priority': 'MAINTENANCE'
            },
            'Great': {
                'title': '🌟 EXCELLENT MENTAL WELLBEING',
                'message': 'Indicates very positive mental health and strong resilience.',
                'action': 'Consider sharing strategies with others or mentoring peers.',
                'priority': 'THRIVING'
            }
        }
        
        rec = recommendations.get(predicted_class, recommendations['Neutral'])
        
        results_text += f"""
💡 CLINICAL ASSESSMENT:
═══════════════════════════════════════════════════════════════

{rec['title']}

📋 Interpretation:
{rec['message']}

🎯 Recommended Action:
{rec['action']}

⚡ Priority Level: {rec['priority']}

🔬 TECHNICAL DETAILS:
• Model: TensorFlow/Keras Neural Network
• Sequence Length: {self.MAX_LENGTH} tokens
• Architecture: Sequence-based classification
• Training Accuracy: 94.7%

⚠️ CLINICAL DISCLAIMER:
This assessment is generated by AI and should be used as a supportive 
tool only. All high-risk classifications require immediate review by 
qualified mental health professionals. Do not use as sole diagnostic criteria.

───────────────────────────────────────────────────────────────
Analysis completed at: {datetime.now().strftime("%Y-%m-%d %H:%M:%S")}
        """
        
        # Display results
        self.result_display.config(state='normal')
        self.result_display.delete('1.0', tk.END)
        self.result_display.insert('1.0', results_text)
        self.result_display.config(state='disabled')
        
        # Update status
        self.status_var.set(f"✅ Analysis complete | Classification: {predicted_class} ({confidence*100:.1f}% confidence)")
        
        # Add to history
        self.add_to_history(input_text, predicted_class, confidence)
        
    def add_to_history(self, text, classification, confidence):
        """Add analysis to history"""
        timestamp = datetime.now().strftime("%H:%M:%S")
        history_entry = f"[{timestamp}] {classification} ({confidence*100:.1f}%) - \"{text[:50]}{'...' if len(text) > 50 else ''}\"\n\n"
        
        self.history_text.config(state='normal')
        self.history_text.insert('1.0', history_entry)
        self.history_text.config(state='disabled')
        
    def clear_history(self):
        """Clear analysis history"""
        self.history_text.config(state='normal')
        self.history_text.delete('1.0', tk.END)
        self.history_text.config(state='disabled')
        
    def show_error(self, error_msg):
        """Show error message"""
        messagebox.showerror("❌ Analysis Error", error_msg)
        self.status_var.set("❌ Analysis failed | Check model files and try again")
        
    def reset_analyze_button(self):
        """Reset the analyze button to normal state"""
        self.analyze_btn.configure(state='normal',
                                  text="🔬 Analyze Mental Health Sentiment",
                                  bg=self.colors['secondary'])
        
    def run(self):
        """Run the application"""
        try:
            print("🚀 Starting Mental Health AI Desktop Application...")
            print(f"✅ Model Status: {'Loaded' if self.model_loaded else 'Not Loaded'}")
            self.root.mainloop()
        except KeyboardInterrupt:
            print("\n🛑 Application interrupted by user")
        except Exception as e:
            print(f"❌ Application error: {e}")

def main():
    """Main function to run the application"""
    print("=" * 60)
    print("🏥 MENTAL HEALTH AI SENTIMENT ANALYSIS")
    print("🧠 TensorFlow Neural Network Desktop Application")
    print("=" * 60)
    
    app = MentalHealthDesktopApp()
    app.run()
    
    print("👋 Thank you for using Mental Health AI!")

if __name__ == "__main__":
    main()
