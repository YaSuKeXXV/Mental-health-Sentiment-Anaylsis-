                'icon': '🚨'
            },
            {
                'text': "I feel kinda nervous and stressed lately.",
                'expected': 'Worried',
                'icon': '😰'
            },
            {
                'text': "Not bad, just a typical day.",
                'expected': 'Neutral',
                'icon': '😐'
            },
            {
                'text': "I finished my to do list and feel good about it.",
                'expected': 'Good',
                'icon': '😊'
            },
            {
                'text': "Honestly, I love my life right now!",
                'expected': 'Great',
                'icon': '🌟'
            }
        ]
        
        for i, example in enumerate(examples):
            btn = tk.Button(examples_frame,
                           text=f"{example['icon']} {example['text'][:50]}..." if len(example['text']) > 50 else f"{example['icon']} {example['text']}",
                           font=('Arial', 9),
                           bg=self.colors['light'],
                           fg=self.colors['primary'],
                           activebackground='#d5dbdb',
                           relief='flat',
                           anchor='w',
                           padx=10,
                           pady=5,
                           cursor='hand2',
                           command=lambda ex=example['text']: self.load_example(ex))
            btn.pack(fill='x', pady=2)
            
    def create_results_panel(self, parent):
        """Create the results panel"""
        panel = tk.LabelFrame(parent,
                             text="📊 Assessment Results & Clinical Insights",
                             font=('Arial', 14, 'bold'),
                             bg='white',
                             fg=self.colors['primary'],
                             padx=15,
                             pady=15)
        
        # Results display with tabs
        notebook = ttk.Notebook(panel)
        notebook.pack(fill='both', expand=True, pady=(10, 0))
        
        # Main Results Tab
        results_frame = tk.Frame(notebook, bg='white')
        notebook.add(results_frame, text='🎯 Classification')
        
        self.result_display = scrolledtext.ScrolledText(results_frame,
                                                       height=20,
                                                       font=('Consolas', 11),
                                                       state='disabled',
                                                       wrap=tk.WORD,
                                                       bg='#f8f9fa',
                                                       borderwidth=1,
                                                       relief='solid')
        self.result_display.pack(fill='both', expand=True, padx=10, pady=10)
        
        # Statistics Tab
        stats_frame = tk.Frame(notebook, bg='white')
        notebook.add(stats_frame, text='📈 Model Stats')
        
        self.create_stats_display(stats_frame)
        
        # History Tab
        history_frame = tk.Frame(notebook, bg='white')
        notebook.add(history_frame, text='📋 History')
        
        self.create_history_display(history_frame)
        
        # Initial display
        self.show_welcome_message()
        
        return panel
        
