    def create_history_display(self, parent):
        """Create analysis history display"""
        self.history_text = scrolledtext.ScrolledText(parent,
                                                     height=20,
                                                     font=('Arial', 10),
                                                     state='disabled',
                                                     wrap=tk.WORD,
                                                     bg='#f8f9fa')
        self.history_text.pack(fill='both', expand=True, padx=10, pady=10)
        
        # Clear history button
        clear_history_btn = tk.Button(parent,
                                     text="🗑️ Clear History",
                                     font=('Arial', 10),
                                     bg=self.colors['warning'],
                                     fg='white',
                                     command=self.clear_history)
        clear_history_btn.pack(pady=(0, 10))
        
    def create_footer(self):
        """Create footer with status bar"""
        footer_frame = tk.Frame(self.root, bg=self.colors['primary'], height=40)
        footer_frame.pack(side='bottom', fill='x')
        footer_frame.pack_propagate(False)
        
        # Status label
        self.status_var = tk.StringVar()
        self.status_var.set("🟢 Ready for analysis | Load patient text and click analyze")
        
        status_label = tk.Label(footer_frame,
                               textvariable=self.status_var,
                               font=('Arial', 10),
                               fg='white',
                               bg=self.colors['primary'],
                               anchor='w')
        status_label.pack(side='left', fill='x', expand=True, padx=15, pady=8)
        
        # Version info
        version_label = tk.Label(footer_frame,
                                text="v1.0.0",
                                font=('Arial', 9),
                                fg=self.colors['light'],
                                bg=self.colors['primary'])
        version_label.pack(side='right', padx=15, pady=8)
        
    def clear_placeholder(self, event):
        """Clear placeholder text when user clicks on text area"""
        current_text = self.text_input.get('1.0', tk.END).strip()
        if "Type or paste patient text here" in current_text:
            self.text_input.delete('1.0', tk.END)
            
    def clear_text(self):
        """Clear the text input"""
        self.text_input.delete('1.0', tk.END)
        self.text_input.focus()
        
    def load_example(self, example):
        """Load example text into input"""
        self.text_input.delete('1.0', tk.END)
        self.text_input.insert('1.0', example)
        self.status_var.set(f"📝 Loaded example text | Click analyze to process")
        
    def show_welcome_message(self):
        """Show welcome message in results panel"""
        welcome_msg = """
