  const simulateModelPrediction = (text) => {
    const riskWords = ['stop', 'end', 'die', 'kill', 'hurt', 'pain', 'hopeless', 'worthless', 'suicide', 'nothing', 'anymore'];
    const worriedWords = ['nervous', 'anxious', 'stress', 'worried', 'scared', 'afraid', 'panic', 'overwhelmed'];
    const goodWords = ['good', 'better', 'accomplished', 'proud', 'happy', 'satisfied', 'progress'];
    const greatWords = ['love', 'amazing', 'fantastic', 'wonderful', 'excellent', 'perfect', 'brilliant'];
    
    const words = text.toLowerCase().split(/\W+/);
    let scores = { Risk: 0, Worried: 0, Neutral: 20, Good: 0, Great: 0 };
    
    words.forEach(word => {
      if (riskWords.includes(word)) scores.Risk += 30;
      if (worriedWords.includes(word)) scores.Worried += 25;
      if (goodWords.includes(word)) scores.Good += 25;
      if (greatWords.includes(word)) scores.Great += 30;
    });
    
    // Add some randomness and normalization
    const total = Object.values(scores).reduce((a, b) => a + b, 0);
    const normalized = {};
    Object.keys(scores).forEach(key => {
      normalized[key] = Math.round((scores[key] / total) * 100);
    });
    
    const predictedClass = Object.keys(normalized).reduce((a, b) => 
      normalized[a] > normalized[b] ? a : b
    );
    
    const confidence = normalized[predictedClass] / 100;
    
    return {
      input: text,
      predicted_class: predictedClass,
      confidence: Math.min(0.99, Math.max(0.60, confidence + Math.random() * 0.2)),
      breakdown: normalized
    };
  };

